# Copy to .env and change the password before exposing the server. Guide: docs/DESPLIEGUE.md
RACHA_PORT=8080
RACHA_DB_NAME=racha
RACHA_DB_USER=racha
RACHA_DB_PASSWORD=change-me
RACHA_BASE_PATH=
# At least 32 bytes: openssl rand -base64 48. If it changes, every device has to sign in again.
RACHA_JWT_SECRET=
# open | closed (after creating your own account)
RACHA_REGISTRATION=open
