# Copy to .env (next to docker-compose.yml), one VARIABLE=value per line, no spaces around "=", no quotes.
# Guide: docs/DESPLIEGUE.md. Only RACHA_JWT_SECRET and RACHA_DB_PASSWORD are really needed; the rest is optional.

# --- Required ---
# At least 32 bytes: openssl rand -base64 48. Keep it fixed (sessions survive restarts anyway).
RACHA_JWT_SECRET=
# Set it BEFORE the first start: PostgreSQL takes it when it creates the database. openssl rand -hex 24
RACHA_DB_PASSWORD=

# --- Server ---
RACHA_PORT=8080
RACHA_BASE_PATH=
# open | closed (after creating your own account)
RACHA_REGISTRATION=open
# Your account (admin screen). Empty: the first account to register.
RACHA_ADMIN_EMAIL=
# How users reach the server, for links in e-mails: https://racha.example.com
RACHA_PUBLIC_URL=
# Proxies that may tell the client's address: local (Cloudflare Tunnel, nginx, Caddy on this machine or LAN),
# cloudflare (Cloudflare's proxy pointing at this server), both (local,cloudflare), none, or CIDRs.
RACHA_TRUSTED_PROXIES=local
RACHA_TZ=Europe/Madrid

# --- Folders ---
RACHA_DATA_DIR=./data
RACHA_BACKUP_DIR=./backups
RACHA_BACKUP_TIME=03:30
RACHA_BACKUP_KEEP_DAILY=14
RACHA_BACKUP_KEEP_WEEKLY=8

# --- E-mail for password recovery (any SMTP: your provider, Gmail with an app password…) ---
RACHA_MAIL_HOST=
RACHA_MAIL_PORT=587
RACHA_MAIL_USERNAME=
RACHA_MAIL_PASSWORD=
# starttls (587) | ssl (465) | none
RACHA_MAIL_SECURITY=starttls
# Sender address; empty: RACHA_MAIL_USERNAME
RACHA_MAIL_FROM=

# --- Metrics (Prometheus at /actuator/prometheus with "Authorization: Bearer <token>"); empty: closed ---
RACHA_METRICS_TOKEN=
